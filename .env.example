NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_DATABASE=your_database
DB_AUTOLOAD_ENTITIES=true
# Production: set to false and run migrations instead
DB_SYNCHRONIZE=false
DB_LOGGING=false

JWT_SECRET=your_secret_key
JWT_EXPIRATION=1d
REFRESH_TOKEN_EXPIRATION=7d

# Comma-separated origins for CORS (Web UI URL in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional legacy fallback for edge auth (prefer per-site API keys)
EDGE_API_KEY=

# Set to true to expose Swagger in production (default: off in production)
SWAGGER_ENABLED=false
